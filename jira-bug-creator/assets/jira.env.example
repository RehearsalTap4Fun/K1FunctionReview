# Jira Bug Creator 配置文件
# 复制此文件为 ~/.env.jira 并填入你自己的 Token

# ========== Jira 配置 ==========
# Jira 服务器地址
JIRA_URL=https://jira.tap4fun.com/

# Jira 个人访问令牌
# 获取方式: Jira 个人设置 → Personal Access Tokens → 创建新 Token
JIRA_PERSONAL_TOKEN=your_token_here

# 默认项目 Key (可在命令行用 -p 参数覆盖，可选: NK, X1, X15)
# NK  = K1_CD(NK)，Bug 单号格式 NK-1234
# X1  = X1(X1)，Bug 单号格式 X1-1234
# X15 = X15(X15)，Bug 单号格式 X15-1234（早期项目，无 Bug 等级 / 归属功能字段）
JIRA_PROJECT=NK

# ========== NK 项目配置 (K1) ==========
LEADER_PLANNER_NK=
LEADER_CLIENT_NK=
LEADER_SERVER_NK=
LEADER_OPERATION_NK=
DEFAULT_TEST_ASSIGNEE_NK=
DEFAULT_RELATED_FUNCTION_NK=

# ========== X1 项目配置 ==========
LEADER_PLANNER_X1=
LEADER_CLIENT_X1=
LEADER_SERVER_X1=
LEADER_OPERATION_X1=
DEFAULT_TEST_ASSIGNEE_X1=
DEFAULT_RELATED_FUNCTION_X1=

# ========== X15 项目配置 ==========
# X15 项目没有"归属功能"字段，DEFAULT_RELATED_FUNCTION_X15 保留为空即可
LEADER_PLANNER_X15=
LEADER_CLIENT_X15=
LEADER_SERVER_X15=
LEADER_OPERATION_X15=
DEFAULT_TEST_ASSIGNEE_X15=
DEFAULT_RELATED_FUNCTION_X15=

# ========== 通用配置（可选）==========
# 默认重现概率
DEFAULT_REPRODUCE_RATE=Always

# 用户名邮箱映射（如果用户名无法建单，可配置邮箱）
# 格式: USER_用户名=邮箱
# 示例:
# USER_zhangsan=zhangsan@nibirutech.com
